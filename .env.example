# Discogs authentication – copy to .env and fill in your values.
# See README "Authentication" for details.

# Personal Access Token (CLI, GUI, Auto-Sort)
# Discogs → Settings → Developers → Personal Access Tokens
DISCOGS_TOKEN=

# OAuth (Auto-Sort GUI "Sign in" – optional if bundled in core/discogs_oauth_app.py)
# Discogs → Settings → Developers → Create Application (callback http://127.0.0.1:8765/callback)
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
